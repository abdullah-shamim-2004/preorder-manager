

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model preorder {
    id  String   @id @default(cuid())
    name String
    products Int @default(1)
    preorderwhen Preorderwhen @default(REGARDLESS_OF_STOCK)
    startsAt DateTime
    endAt DateTime?
    status Boolean @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
enum Preorderwhen {
   REGARDLESS_OF_STOCK
  WHEN_OUT_OF_STOCK

}